  "z-image-controlnet": {
    "name": "Z-Image ControlNet",
    "filename": "z-image/controlnet.json",
    "module": "z-image-control",
    "description": "Follow the shape of a reference image - pose, edges or depth.",
    "_negative": "The graph feeds one Text Concatenate to both the positive and the negative slot, so there is no separate negative text to expose. Adding a control here would silently write into the positive prompt.",
