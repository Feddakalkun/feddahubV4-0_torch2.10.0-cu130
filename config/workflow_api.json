        "label": "Prompt"
      },
      "control_mode": {
        "node_id": "117",
        "input_key": "select",
        "label": "Control Mode",
        "_why": "An ImpactSwitch index. object_info calls it an INT, correctly, and a spinner from 1 to 999999 is useless for choosing between pose and depth - only whoever wired the switch knows what each position feeds. Hence the override; the values are node 117's input1..input5 in order.",
        "control": "chips",
        "choices": [
          {
            "value": 1,
            "label": "Depth"
          },
          {
            "value": 2,
            "label": "Pose"
          },
          {
            "value": 3,
            "label": "Canny"
          },
          {
            "value": 4,
            "label": "Canny Edge"
          },
          {
            "value": 5,
            "label": "Soft Edge"
          }
        ]
      },
