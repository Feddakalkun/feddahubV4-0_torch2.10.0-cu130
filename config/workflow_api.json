  "z-image-controlnet": {
    "name": "Z-Image ControlNet",
    "filename": "z-image/controlnet.json",
    "module": "z-image-control",
    "description": "Follow the shape of a reference image - pose, edges or depth.",
    "_negative": "The graph feeds one Text Concatenate to both the positive and the negative slot, so there is no separate negative text to expose. Adding a control here would silently write into the positive prompt.",
    "inputs": {
      "image": {
        "node_id": "99",
        "input_key": "image",
        "label": "Reference Image"
      },
      "prompt": {
        "node_id": "113",
        "input_key": "string",
        "label": "Prompt"
      },
      "control_mode": {
        "node_id": "117",
        "input_key": "select",
        "label": "Control Mode",
        "_why": "An ImpactSwitch index. object_info calls it an INT, correctly, and a spinner from 1 to 999999 is useless for choosing between pose and depth - only whoever wired the switch knows what each position feeds. Hence the override; the values are node 117's input1..input5 in order.",
        "control": "chips",
        "choices": [
          {
            "value": 1,
            "label": "Depth"
          },
          {
            "value": 2,
            "label": "Pose"
          },
          {
            "value": 3,
            "label": "Canny"
          },
          {
            "value": 4,
            "label": "Canny Edge"
          },
          {
            "value": 5,
            "label": "Soft Edge"
          }
        ]
      },
      "control_strength": {
        "node_id": "101",
        "input_key": "strength",
        "label": "Control Strength"
      },
      "width": {
        "node_id": "86",
        "input_key": "width",
        "label": "Width"
      },
      "height": {
        "node_id": "86",
        "input_key": "height",
        "label": "Height"
      },
      "seed": {
        "node_id": "83",
        "input_key": "seed",
        "label": "Seed"
      },
      "steps": {
        "node_id": "83",
        "input_key": "steps",
        "label": "Steps"
      },
      "cfg": {
        "node_id": "83",
        "input_key": "cfg",
        "label": "CFG Scale"
      },
      "denoise": {
        "node_id": "83",
        "input_key": "denoise",
        "label": "Denoise"
      },
      "loras": {
        "node_id": "129",
        "type": "loras",
        "label": "LoRAs"
      }
    }
  },
  "z-image-inpaint": {
    "name": "Z-Image Inpaint",
    "filename": "z-image/inpaint.json",
    "module": "z-image-inpaint",
